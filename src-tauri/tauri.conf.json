{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nimble Newt",
  "version": "0.1.0",
  "identifier": "com.ferdinand99.nimblenewt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nimble Newt",
        "width": 1100,
        "height": 740,
        "minWidth": 480,
        "minHeight": 320,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "A fast, modern text editor",
    "licenseFile": "../LICENSE",
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "wix": { "language": "en-US" } },
    "fileAssociations": [
      { "ext": ["txt", "text", "log"], "name": "Text document", "role": "Editor" },
      { "ext": ["md", "markdown"], "name": "Markdown document", "role": "Editor" },
      { "ext": ["json", "yaml", "yml", "toml", "xml", "ini", "cfg", "conf", "csv"], "name": "Data file", "role": "Editor" },
      { "ext": ["js", "mjs", "ts", "tsx", "jsx", "css", "html", "htm", "py", "rs", "go", "c", "h", "cpp", "hpp", "cs", "java", "sql", "sh", "ps1"], "name": "Source file", "role": "Editor" }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Ferdinand99/Nimble-Newt/releases/latest/download/latest.json"],
      "pubkey": "REPLACE_WITH_PUBLIC_KEY_SEE_docs/updates.md",
      "windows": { "installMode": "passive" }
    }
  }
}
